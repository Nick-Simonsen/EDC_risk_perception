y community."},"5":{"Display":"I believe that the regulatory agencies responsible for monitoring and controlling endocrine-disrupting chemicals would never knowingly allow dangerous products to be placed on the market."},"6":{"Display":"I believe that businesses are taking appropriate measures to minimize the use of endocrine-disrupting chemicals in their products."}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":8,"Answers":{"1":{"Display":"1 - Strongly disagree"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID35","DataVisibility":{"Private":false,"Hidden":false},"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tthis.hidePreviousButton();\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_cIIu0PcF9ruzfRY","Element":"SQ","PrimaryAttribute":"QID36","SecondaryAttribute":"Age","TertiaryAttribute":null,"Payload":{"QuestionText":"Age","DefaultChoices":false,"DataExportTag":"Q27","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Age","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID36"}},{"SurveyID":"SV_cIIu0PcF9ruzfRY","Element":"SQ","PrimaryAttribute":"QID37","SecondaryAttribute":"Education level","TertiaryAttribute":null,"Payload":{"QuestionText":"Education level","DefaultChoices":false,"DataExportTag":"Q28","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Education level","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID37"}},{"SurveyID":"SV_cIIu0PcF9ruzfRY","Element":"SQ","PrimaryAttribute":"QID38","SecondaryAttribute":"Gender","TertiaryAttribute":null,"Payload":{"QuestionText":"Gender","DefaultChoices":false,"DataExportTag":"Q29","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"maleFemale","Type":"likert","Reverse":false}}},"QuestionDescription":"Gender","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Non-binary \/ third gender"},"4":{"Display":"Prefer not to say"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID38"}},{"SurveyID":"SV_cIIu0PcF9ruzfRY","Element":"SQ","PrimaryAttribute":"QID39","SecondaryAttribute":"Endocrine Disrupting Chemicals (EDCs) are substances that are believed to have the potential to i...","TertiaryAttribute":null,"Payload":{"QuestionText":"<br>Endocrine Disrupting Chemicals (EDCs) are substances that are believed to have the potential to influence the body endocrine system. EDCs can be encountered in a variety of everyday life products, ranging from household items to personal care products and beyond. In this study we will talk specifically about the following EDCs:&nbsp;<br>Bisphenol A (BPA):\n\nFound in some plastic containers, food packaging, and thermal receipts.<br>Brominated Flame Retardants (BFRs):\n\nFound in certain electronics, furniture, and flame-retardant materials<br>Parabens:\n\nUsed as preservatives in cosmetics, pharmaceuticals, and some food products.<br>Pesticides:\n\nPresent in residues on fruits and vegetables, and commonly used in agriculture.<br>Per- and Polyfluoroalkyl Substances (PFAS):\n\nFound in non-stick cookware, waterproof fabrics, and some food packaging.<br>Phthalates:\n\nPresent in some plastics, personal care products, and certain medications.<br>Polychlorinated Biphenyls (PCBs):\n\nHistorically used in electrical equipment, cooling fluids, and some building materials.<br><br>","DefaultChoices":false,"DataExportTag":"Q30","QuestionID":"QID39","QuestionType":"HeatMap","Selector":"Image","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Endocrine Disrupting Chemicals (EDCs) are substances that are believed to have the potential to i...","Choices":{"1":{"Display":"X,Y"},"2":{"Display":"X,Y"},"3":{"Display":"X,Y"},"4":{"Display":"X,Y"},"5":{"Display":"X,Y"},"6":{"Display":"X,Y"},"7":{"Display":"X,Y"}},"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":110,"NextAnswerId":1,"Height":481,"Width":816,"GraphicVersion":1702381450988,"GraphicID":"IM_9ZbLWt4VGjrwKGy","Clicks":7,"Regions":[{"Description":"Parabens","Height":108,"Shapes":[[{"X":226,"Y":54},{"X":324,"Y":54},{"X":324,"Y":162},{"X":226,"Y":162}]],"Type":"Polygon","Width":98,"X":226,"Y":54},{"Description":"Phthalates","Height":108,"Shapes":[[{"X":431,"Y":70},{"X":529,"Y":70},{"X":529,"Y":178},{"X":431,"Y":178}]],"Type":"Polygon","Width":98,"X":431,"Y":70},{"Type":"Polygon","Shapes":[[{"X":97,"Y":185},{"X":247,"Y":185},{"X":247,"Y":335},{"X":97,"Y":335}]],"Description":"Region #3","X":97,"Y":185,"Width":15